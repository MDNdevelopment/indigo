---
import { site } from '../config/site';
import type { Lang } from '../config/site';
import { getT, localePath } from '../i18n';
import logoWhite from '../assets/brand/logo-indigo-blanco.svg';
export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getT(lang);
const showCookies = site.analytics.consent === 'banner';
const social = Object.entries(site.social).filter(([, v]) => v) as [string, string][];
const socialLabel: Record<string, string> = { instagram: 'Instagram', linkedin: 'LinkedIn' };
const pages = [
  { label: t.nav.about, href: '/nosotros' },
  { label: t.nav.services, href: '/servicios' },
  { label: t.nav.solutions, href: '/soluciones' },
  { label: t.nav.sectors, href: '/sectores' },
  { label: t.nav.projects, href: '/proyectos' },
  { label: t.footer.quality, href: '/calidad' },
  { label: t.nav.contact, href: '/contacto' },
];
---

<footer class="footer">
  <div class="wrap">
    <span class="hairline footer-rule" data-rule aria-hidden="true"></span>
    <div class="footer-grid">
      <div class="footer-about">
        <img class="footer-logo" src={logoWhite.src} width="220" height="53" alt={site.name} loading="lazy" />
      </div>
      <div>
        <h3>{t.footer.navTitle}</h3>
        <ul>
          {pages.map((p) => <li><a href={localePath(lang, p.href)}>{p.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h3>{t.footer.contactTitle}</h3>
        <ul>
          <li><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>{site.address.street}, {site.address.city} {site.address.postalCode}</li>
          <li><a href={`mailto:${site.hrEmail}`}>{t.footer.careers}</a></li>
        </ul>
      </div>
      {social.length > 0 && (
        <div>
          <h3>{t.footer.followTitle}</h3>
          <ul>
            {social.map(([k, url]) => <li><a href={url} target="_blank" rel="noopener">{socialLabel[k] ?? k}</a></li>)}
          </ul>
        </div>
      )}
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {site.legalName} {t.common.legalRights} {t.footer.rif} {site.rif}</span>
      <span class="footer-legal">
        <a href={localePath(lang, '/politica-de-privacidad')}>{t.legal.privacyLink}</a>
        <a href={localePath(lang, '/politica-de-cookies')}>{t.legal.cookiesLink}</a>
        {showCookies && <button type="button" class="link-button" data-cookie-settings>{t.legal.cookieSettings}</button>}
      </span>
      {site.credit && <span>{t.common.credit}</span>}
    </div>
  </div>
</footer>
