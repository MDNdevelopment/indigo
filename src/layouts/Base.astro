---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import type { Lang } from '../config/site';
import Seo from '../components/Seo.astro';
import JsonLd from '../components/JsonLd.astro';
import Analytics from '../components/Analytics.astro';
import CookieBanner from '../components/CookieBanner.astro';
export interface Props {
  title: string;
  lang: Lang;
  description?: string;
  /** ruta sin idioma, p. ej. /nosotros */
  path?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}
const { title, lang, description, path, image, noindex, jsonLd } = Astro.props;
---

<!doctype html>
<html lang={lang} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Pre-oculta solo el arranque del hero cuando habrá animación. Sin JS o con reduced-motion todo se ve; salvaguarda de 4 s. -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('has-motion');
        setTimeout(function () { document.documentElement.classList.remove('has-motion'); }, 4000);
      }
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-display-src" preload />
    <Font cssVariable="--font-body-src" preload />
    <Seo {title} {lang} {description} {path} {image} {noindex} />
    <JsonLd {lang} nodes={jsonLd} />
    <Analytics />
    <ClientRouter fallback="none" />
    <script is:inline>
      // Anclas entre páginas (/#contacto): el layout cambia después de la carga
      // (fuentes, content-visibility, ScrollTrigger); se re-posiciona hasta estabilizar.
      (function () {
        var id = decodeURIComponent(location.hash.slice(1));
        if (!id) return;
        var tries = 0;
        function go() {
          var el = document.getElementById(id);
          if (!el) return;
          var y = el.getBoundingClientRect().top + window.scrollY - 88;
          window.scrollTo({ top: Math.max(0, y), behavior: 'instant' });
        }
        function settle() {
          go();
          if (++tries < 8) setTimeout(settle, 150);
        }
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        window.addEventListener('load', settle);
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <CookieBanner {lang} />
    <div class="page-diamonds" data-page-diamonds aria-hidden="true" transition:persist="diamonds"></div>
    <script>
      import '../scripts/boot.ts';
    </script>
  </body>
</html>
