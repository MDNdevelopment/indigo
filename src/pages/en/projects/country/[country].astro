---
import Projects from '../../../../views/Projects.astro';
import { slugFor } from '../../../../i18n';
import { projects, countrySlugs } from '../../../../data/projects';

export function getStaticPaths() {
  const items = [...new Set(projects.map((p) => p.country))];
  return items.map((country) => ({ params: { country: slugFor('en', countrySlugs[country]) }, props: { country } }));
}
const { country } = Astro.props;
const lang = 'en';
---

<Projects lang={lang} country={country} />
