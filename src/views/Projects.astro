---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Media from '../components/Media.astro';
import PageHero from '../components/PageHero.astro';
import CtaEnd from '../components/CtaEnd.astro';
import type { Lang } from '../config/site';
import { getT, localePath } from '../i18n';
import { photos } from '../data/photos';
import { projects, projectText, countryNames, countrySlugs } from '../data/projects';
import { sectors } from '../data/sectors';
import { breadcrumbSchema } from '../lib/schema';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getT(lang);
const p = t.projectsPage;
const L = (path: string) => localePath(lang, path);
const filters = sectors.filter((s) => projects.some((pr) => pr.sector === s.id));
const countries = [...new Set(projects.map((pr) => pr.country))];
const path = '/proyectos';
const crumbs = [{ name: t.common.home, path: '/' }, { name: t.nav.projects, path }];
---

<Base title={t.nav.projects} lang={lang} description={p.meta} {path} jsonLd={[breadcrumbSchema(lang, crumbs)]}>
  <Nav lang={lang} {path} dark />
  <main id="main">
    <PageHero title={p.title} intro={p.intro} image={photos.bombas} pos="50% 60%" />

    <section class="section" data-filter-root>
      <div class="wrap">
        <span class="hairline" data-rule aria-hidden="true"></span>
        <div class="filters" data-filter-bar hidden role="group" aria-label={p.filterLabel}>
          <button type="button" data-filter="todos" aria-pressed="true" hidden>{t.common.all}</button>
          {filters.map((f) => <button type="button" data-filter={f.id} aria-pressed="false" hidden>{f[lang].title}</button>)}
        </div>
        <div class="by-country" data-country-bar hidden role="group" aria-label={p.byCountry}>
          <span>{p.byCountry}</span>
          <ul data-cols>
            <li><button type="button" data-country-filter="todos" aria-pressed="true">{t.common.all}</button></li>
            {countries.map((c) => (
              <li><button type="button" data-country-filter={countrySlugs[c]} aria-pressed="false">{countryNames[c][lang]}</button></li>
            ))}
          </ul>
        </div>
        <ul class="grid-projects">
          {projects.map((pr) => {
            const x = projectText(pr, lang);
            return (
              <li data-item data-cat={pr.sector} data-country-id={countrySlugs[pr.country]}>
                <a class="project-link" href={L(`/proyectos/${pr.slug}`)}>
                  <Media src={pr.image} alt={x.title} ratio="4 / 3" sizes="(min-width: 1000px) 31vw, (min-width: 640px) 46vw, 100vw" pos={pr.pos} />
                  <h2>{x.title}</h2>
                  <p>{x.place}{pr.year ? `, ${pr.year}` : ''}</p>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <CtaEnd lang={lang} title={p.cta.title} text={p.cta.text} />
  </main>
  <Footer lang={lang} />
</Base>
