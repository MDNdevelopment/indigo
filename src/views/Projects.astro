---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Media from '../components/Media.astro';
import PageHero from '../components/PageHero.astro';
import CtaEnd from '../components/CtaEnd.astro';
import type { Lang } from '../config/site';
import { getT, localePath } from '../i18n';
import { photos } from '../data/photos';
import { projects as allProjects, projectText, countryNames, countrySlugs } from '../data/projects';
import type { CountryId } from '../data/projects';
import { sectors } from '../data/sectors';
import { breadcrumbSchema } from '../lib/schema';

export interface Props {
  lang: Lang;
  /** si viene, lista solo los proyectos de ese país */
  country?: CountryId;
}
const { lang, country } = Astro.props;
const t = getT(lang);
const p = t.projectsPage;
const L = (path: string) => localePath(lang, path);
const projects = country ? allProjects.filter((pr) => pr.country === country) : allProjects;
const filters = sectors.filter((s) => projects.some((pr) => pr.sector === s.id));
const countries = [...new Set(allProjects.map((pr) => pr.country))];
const countryName = country ? countryNames[country][lang] : '';
const fill = (str: string) => str.replaceAll('{country}', countryName);
const path = country ? `/proyectos/pais/${countrySlugs[country]}` : '/proyectos';
const title = country ? fill(p.country.title) : p.title;
const intro = country ? fill(p.country.intro) : p.intro;
const meta = country ? fill(p.country.meta) : p.meta;
const crumbs = [{ name: t.common.home, path: '/' }, { name: t.nav.projects, path: '/proyectos' }, ...(country ? [{ name: countryName, path }] : [])];
---

<Base title={country ? title : t.nav.projects} lang={lang} description={meta} {path} jsonLd={[breadcrumbSchema(lang, crumbs)]}>
  <Nav lang={lang} {path} dark />
  <main id="main">
    <PageHero title={title} intro={intro} image={country ? projects[0].image : photos.bombas} pos={country ? projects[0].pos : '50% 60%'} />

    <section class="section" data-filter-root data-live={country ? undefined : ''}>
      <div class="wrap">
        <div class="filters" data-filter-bar hidden role="group" aria-label={p.filterLabel}>
          <button type="button" data-filter="todos" aria-pressed="true" hidden>{t.common.all}</button>
          {filters.map((f) => <button type="button" data-filter={f.id} aria-pressed="false" hidden>{f[lang].title}</button>)}
        </div>
        <nav class="by-country" aria-label={p.byCountry}>
          <span>{p.byCountry}</span>
          <ul>
            <li><a href={L('/proyectos')} data-country-filter="todos" aria-current={country ? undefined : 'page'}>{t.common.all}</a></li>
            {countries.map((c) => (
              <li><a href={L(`/proyectos/pais/${countrySlugs[c]}`)} data-country-filter={countrySlugs[c]} aria-current={c === country ? 'page' : undefined}>{countryNames[c][lang]}</a></li>
            ))}
          </ul>
        </nav>
        <ul class="grid-projects">
          {projects.map((pr) => {
            const x = projectText(pr, lang);
            return (
              <li data-item data-cat={pr.sector} data-country-id={countrySlugs[pr.country]}>
                <a class="project-link" href={L(`/proyectos/${pr.slug}`)}>
                  <Media src={pr.image} alt={x.title} ratio="4 / 3" sizes="(min-width: 1000px) 31vw, (min-width: 640px) 46vw, 100vw" pos={pr.pos} />
                  <h2>{x.title}</h2>
                  <p>{x.place}{pr.year ? `, ${pr.year}` : ''}</p>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <CtaEnd lang={lang} title={p.cta.title} text={p.cta.text} />
  </main>
  <Footer lang={lang} />
</Base>
